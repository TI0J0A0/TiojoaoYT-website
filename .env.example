# Copie este arquivo para .env.local e preencha com suas chaves.
# O .env.local fica só no seu computador (está no .gitignore).
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Twitch (dev.twitch.tv → seu app)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_LOGIN=tiojoaoyt

# Kick (dev.kick.com → seu app)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Supabase (Project Settings → API Keys / Data API)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Chave aleatória para assinar o login (mín. 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Instagram (Casos de uso → Instagram → "Configuração da API com login do Instagram")
# Gere o token com: node scripts/instagram-token.mjs
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_TOKEN=
